@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Вхід";
}

<div style="display:flex;flex-direction:column;justify-content:center;align-items:center;min-height:calc(100vh - 56px);margin:-40px -32px;position:relative;overflow:hidden;">

    <img src="~/images/login-cat.png"
         alt="cat"
         style="position:absolute;left:8%;top:50%;transform:translateY(-50%);width:160px;" />

    <svg style="position:absolute;right:8%;top:50%;transform:translateY(-50%);width:180px;height:180px;" viewBox="0 0 200 200" fill="none">
        <path d="M100 10 C100 10 108 85 190 100 C108 115 100 190 100 190 C100 190 92 115 10 100 C92 85 100 10 100 10Z" stroke="#ccc" stroke-width="1.5" fill="#f5f5f5" opacity="0.8" />
        <path d="M100 10 C100 10 108 85 190 100 C108 115 100 190 100 190 C100 190 92 115 10 100 C92 85 100 10 100 10Z" stroke="#ddd" stroke-width="0.5" fill="none" />
        <path d="M155 38 L157 50 L169 52 L157 54 L155 66 L153 54 L141 52 L153 50 Z" fill="#aaa" />
        <path d="M38 148 L39 155 L46 156 L39 157 L38 164 L37 157 L30 156 L37 155 Z" fill="#bbb" />
        <path d="M168 145 L169 150 L174 151 L169 152 L168 157 L167 152 L162 151 L167 150 Z" stroke="#ccc" stroke-width="1" fill="none" />
    </svg>

    <div style="text-align:center;max-width:400px;z-index:1;">
        <h1 style="font-size:28px;font-weight:600;margin-bottom:10px;">Ознайомтесь з програмою</h1>
        <p style="font-size:14px;color:#888;margin-bottom:32px;line-height:1.6;">
            Всі ваші оголошення в одному<br>місці та під контролем
        </p>

        <div id="g_id_onload"
             data-client_id="@Configuration["GoogleAuth:ClientId"]"
             data-callback="handleGoogleLogin"
             data-auto_prompt="false">
        </div>

        <div class="g_id_signin"
             data-type="standard"
             data-size="large"
             data-theme="filled_black"
             data-text="signin_with"
             data-shape="rectangular"
             data-logo_alignment="left"
             data-width="320">
        </div>

        <div id="loginError" style="display:none;margin-top:16px;font-size:13px;color:#A32D2D;padding:10px 12px;border:0.5px solid #fcc;border-radius:8px;">
            Помилка входу. Спробуйте ще раз.
        </div>

        <p style="font-size:12px;color:#aaa;margin-top:20px;">
            <a asp-controller="Announcements" asp-action="All" style="color:#555;text-decoration:underline;">Переглянути без входу</a>
        </p>
    </div>
</div>

@section Scripts {
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script>
        function handleGoogleLogin(response) {
            fetch('/Auth/GoogleCallback', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(response.credential)
            })
                .then(r => {
                    if (r.ok) {
                        window.location.href = '/';
                    } else {
                        document.getElementById('loginError').style.display = 'block';
                    }
                });
        }
    </script>
}