@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Дошка оголошень";
}

<div style="display:grid;grid-template-columns:1fr 1fr;min-height:calc(100vh - 56px);margin:-40px -32px;padding:0 60px;align-items:center;gap:40px;">
    <div>
        <h1 style="font-size:52px;font-weight:700;line-height:1.1;letter-spacing:-1px;text-transform:uppercase;margin-bottom:20px;">
            НОВИЙ<br>СТАНДАРТ ДЛЯ<br>ОГОЛОШЕНЬ
        </h1>
        <p style="font-size:15px;color:#555;line-height:1.7;margin-bottom:32px;max-width:380px;">
            Зручна платформа для розміщення та пошуку оголошень. Побутова техніка, електроніка, одяг та багато іншого.
        </p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
            <a asp-controller="Announcements" asp-action="All" class="btn-hero-dark">Переглянути оголошення</a>
            @if (Context.Session.GetString("JwtToken") == null)
            {
                <a asp-controller="Auth" asp-action="Login" style="display:inline-flex;align-items:center;padding:14px 28px;border:0.5px solid #ddd;border-radius:8px;font-size:14px;text-decoration:none;color:#111;">Увійти через Google</a>
            }
        </div>
    </div>
    <div style="display:flex;justify-content:center;align-items:center;position:relative;">
        <div style="position:relative;width:100%;max-width:460px;">
            
            <img src="~/images/hero-cat.png" alt="hero" style="width:100%;max-width:420px;position:relative;z-index:1;" />
            <svg style="position:absolute;top:5%;left:20%;width:40px;height:40px;" viewBox="0 0 40 40">
                <path d="M20 0 L22 18 L40 20 L22 22 L20 40 L18 22 L0 20 L18 18 Z" fill="#111" />
            </svg>
            <svg style="position:absolute;top:15%;left:8%;width:24px;height:24px;" viewBox="0 0 40 40">
                <path d="M20 0 L22 18 L40 20 L22 22 L20 40 L18 22 L0 20 L18 18 Z" fill="#111" />
            </svg>
        </div>
    </div>
</div>