<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Дошка оголошень</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon" type="image/png" href="~/images/favicon.png" />
</head>
<body>
    <nav>
        <div class="nav-container">
            <a href="/" class="nav-brand">Дошка оголошень</a>
            <div class="nav-actions">
                @if (Context.Session.GetString("JwtToken") != null)
                {
                    <span class="nav-user">@Context.Session.GetString("UserName")</span>
                    <a asp-controller="Announcements" asp-action="All" class="btn btn-ghost">Оголошення</a>
                    <a asp-controller="Announcements" asp-action="MyAnnouncements" class="btn btn-ghost">Мої оголошення</a>
                    <form asp-controller="Auth" asp-action="Logout" method="post" style="display:inline">
                        <button type="submit" class="btn btn-outline-danger">Вийти</button>
                    </form>
                }
                else if (ViewData["Title"]?.ToString() != "Вхід")
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-primary">Увійти через Google</a>
                }
            </div>
        </div>
    </nav>

    <main class="main-container">
        @RenderBody()
    </main>

    @RenderSection("Scripts", required: false)
</body>
</html>