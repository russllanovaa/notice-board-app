<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Дошка оголошень</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Дошка оголошень</a>
            <div class="navbar-nav ms-auto">
                @if (Context.Session.GetString("JwtToken") != null)
                {
                        <span class="navbar-text me-3">
                            Привіт, @Context.Session.GetString("UserName")!
                        </span>
                        <a class="btn btn-outline-light me-2"
                           asp-controller="Announcements"
                           asp-action="Create">
                            Додати оголошення
                        </a>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger">Вийти</button>
                        </form>
                }
                else
                {
                        <a class="btn btn-outline-light"
                           asp-controller="Auth"
                           asp-action="Login">
                            Увійти через Google
                        </a>
                }
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>