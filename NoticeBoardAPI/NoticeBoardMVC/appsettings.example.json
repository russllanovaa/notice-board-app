{
  "ApiSettings": {
    "BaseUrl": "https://localhost:ПОРТ_ВАШОГО_API"
  },
  "GoogleAuth": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_VERY_LONG_SECRET_KEY_HERE",
    "Issuer": "NoticeBoardAPI",
    "Audience": "NoticeBoardMVC",
    "ExpiryDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}