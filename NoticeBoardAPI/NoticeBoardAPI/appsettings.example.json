{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=notice_board;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "GoogleAuth": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_SECRET_KEY_MINIMUM_32_CHARACTERS",
    "Issuer": "NoticeBoardAPI",
    "Audience": "NoticeBoardClient",
    "ExpiryDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
